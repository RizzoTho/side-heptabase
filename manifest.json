{
  "manifest_version": 3,
  "name": "Side Heptabase",
  "version": "0.2.0",
  "description": "Write a markdown note in the side panel and save it (with the current page link) to Heptabase.",
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["https://api.heptabase.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Side Heptabase"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
