{
  "manifest_version": 3,
  "name": "Side Heptabase",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "description": "Capture notes, journal entries, links, and checklist items in Heptabase from a side panel or floating control.",
  "permissions": ["sidePanel", "tabs", "storage", "clipboardWrite", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "exclude_matches": ["https://api.heptabase.com/*"],
    "css": ["floating/editor-inline.css"],
    "js": ["floating/icons.js", "floating/meta-icon.js", "floating/floating.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["floating/floating.css", "sidepanel/md-editor.js"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Side Heptabase"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
